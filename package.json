{
  "name": "flashcard",
  "version": "0.1.0",
  "author": "Maycon",
  "license": "MIT",
  "engines": {
    "node": "24"
  },
  "scripts": {
    "dev": "npm run services:wait:database && npm run migrations:up && next dev",
    "build": "next build",
    "start": "next start",
    "test": "concurrently -n next,jest  -k -s command-jest \"next dev --webpack\" \"jest --runInBand\"",
    "test:watch": "jest --watchAll --runInBand --verbose",
    "services:wait:database": "node infra/scripts/wait-for-postgres.js",
    "migrations:up": "node-pg-migrate -m infra/migrations --envPath .env.development up",
    "migrations:up:dry": "node-pg-migrate -m infra/migrations --envPath .env.development --dry-run up",
    "migrations:create": "node-pg-migrate --migrations-dir infra/migrations create",
    "lint:check": "npm run lint:eslint:check && npm run lint:prettier:check",
    "lint:eslint:check": "eslint .",
    "lint:prettier:check": "prettier --check .",
    "lint:prettier:fix": "prettier --write .",
    "prepare": "husky",
    "commit": "cz"
  },
  "dependencies": {
    "@bytemd/plugin-breaks": "^1.22.0",
    "@bytemd/plugin-gemoji": "^1.22.0",
    "@bytemd/plugin-gfm": "^1.22.0",
    "@bytemd/plugin-highlight-ssr": "^1.22.0",
    "@bytemd/plugin-math": "^1.22.0",
    "@bytemd/plugin-mermaid": "^1.22.0",
    "@bytemd/react": "^1.22.0",
    "@next/third-parties": "16.2.5",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "bcryptjs": "3.0.3",
    "cookie": "1.1.1",
    "joi": "^18.2.1",
    "lucide-react": "1.14.0",
    "next": "^16.4.6",
    "next-connect": "1.0.0",
    "node-pg-migrate": "7.6.1",
    "nodemailer": "^9.0.3",
    "pg": "8.20.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "rehype-external-links": "^3.0.0",
    "swr": "2.4.1",
    "uuid": "11.1.0"
  },
  "devDependencies": {
    "@commitlint/cli": "20.5.3",
    "@commitlint/config-conventional": "20.5.3",
    "@faker-js/faker": "9.7.0",
    "@tailwindcss/postcss": "4",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "25",
    "@types/nodemailer": "7.0.11",
    "@types/pg": "8.20.0",
    "@types/react": "19",
    "@types/react-dom": "19",
    "async-retry": "1.3.3",
    "commitizen": "4.3.1",
    "concurrently": "9.2.1",
    "dotenv": "17.4.2",
    "dotenv-expand": "13.0.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jest": "29.15.2",
    "husky": "9.1.7",
    "jest": "30.3.0",
    "prettier": "3.8.3",
    "set-cookie-parser": "3.1.0",
    "tailwindcss": "4",
    "ts-jest": "29.4.9",
    "typescript": "6"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
